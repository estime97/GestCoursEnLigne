@inject Microsoft.Extensions.Localization.IStringLocalizer<RoleModal> _localizer

<EditForm Model="@RoleModel" OnValidSubmit="SaveAsync">
    <FluentValidationValidator @ref="_fluentValidationValidator" />
    <MudDialog>
        <TitleContent>
            @{
                if (RoleModel.Id == null)
                {
                    <MudText Typo="Typo.h6">
                        <MudIcon Icon="@Icons.Material.Filled.Add" Class="mr-3 mb-n1" />
                        @_localizer["Ajouter Rôle"]
                    </MudText>
                }
                else
                {
                    <MudText Typo="Typo.h6">
                        <MudIcon Icon="@Icons.Material.Filled.Update" Class="mr-3 mb-n1" />
                        @_localizer["Modifier Rôle"]
                    </MudText>
                }
            }
        </TitleContent>
        <DialogContent>
            <MudPaper Class="pa-4 mb-2 mt-1" Outlined="true">
                <MudTextField For="@(() => RoleModel.Id)" @bind-Value="RoleModel.Id" Label="@_localizer["Rôle ID"]" Disabled />
                <MudTextField For="@(() => RoleModel.Name)" @bind-Value="RoleModel.Name" Label="@_localizer["Libellé Rôle"]" Disabled="true" />
                <MudTextField For="@(() => RoleModel.Description)" @bind-Value="RoleModel.Description" Label="@_localizer["Description"]" />
            </MudPaper>
        </DialogContent>
        <DialogActions>
            <MudButton Variant="Variant.Filled" OnClick="Cancel">@_localizer["Annuler"]</MudButton>
            @{
                if (RoleModel.Id == null)
                {
                    <MudButton Class="mr-3" Variant="Variant.Filled" ButtonType="ButtonType.Submit" Disabled="@(!Validated)" Color="Color.Success">@_localizer["Enrégistrer Rôle"]</MudButton>
                }
                else
                {
                    <MudButton Class="mr-3" Variant="Variant.Filled" ButtonType="ButtonType.Submit" Disabled="@(!Validated)" Color="Color.Secondary">@_localizer["Modifier Rôle"]</MudButton>
                }
            }
        </DialogActions>
    </MudDialog>
</EditForm>