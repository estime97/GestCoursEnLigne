@page "/account"
@inject Microsoft.Extensions.Localization.IStringLocalizer<Account> localizer

<HeroTitle Title="@localizer["Compte"]" Description="@localizer["Gérer son compte"]" />
<MudTabs Elevation="25" Color="Color.Transparent" Rounded="true" PanelClass="mt-6">
    <MudTabPanel Text="@localizer["Profil"]">
        <Profile />
    </MudTabPanel>
    <MudTabPanel Text="@localizer["Sécurité"]">
        <Security />
    </MudTabPanel>
</MudTabs>