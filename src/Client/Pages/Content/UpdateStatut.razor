@using BlazorHero.CleanArchitecture.Domain.Enums
@using BlazorHero.CleanArchitecture.Shared.Enums
@attribute [Authorize(Policy = Permissions.Requisitions.Update)]
<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon=@Icons.Material.Filled.Update Class="mr-3 mb-n1" Color="Color.Primary" /> Mise à jour de statut
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudPaper Class="pa-4 mb-2 mt-1" Outlined="true">
            <EditForm Model="@Command" OnValidSubmit="SubmitAsync">
                <MudGrid Class="mb-2">
                    <MudItem xs="12">
                        <MudInputLabel Class="pb-2">Numéro Requisition</MudInputLabel>
                        <MudTextField T="string" For="@(() => Requisition.NumeroRequisition)" @bind-Value="Requisition.NumeroRequisition" Disabled="true" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudInputLabel Class="pb-2">Ancien Statut</MudInputLabel>
                        <MudSelect Disabled="true" T="string" For="@(() => Requisition.Statut)" @bind-Value="Requisition.Statut">
                            @foreach (var item in Enum.GetValues(typeof(Statut)))
                            {
                                <MudSelectItem Value="@(EnumDescription.GetDescription((Statut)item))">@EnumDescription.GetDescription((Statut)item)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudDivider />

                    <MudItem xs="12">
                        <MudInputLabel Class="pb-2">Position actuelle</MudInputLabel>
                        <MudSelect T="ActualPosition" For="@(() => Command.PositionActuelle)" @bind-Value="Command.PositionActuelle">
                            @foreach (var item in Enum.GetValues(typeof(ActualPosition)))
                            {
                                <MudSelectItem Value="@(EnumDescription.GetDescription((ActualPosition)item))">@EnumDescription.GetDescription((ActualPosition)item)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12">
                        <MudInputLabel Class="pb-2">Nouveau statut</MudInputLabel>
                        <MudSelect T="string" For="@(() => Command.Statut)" @bind-Value="Command.Statut">
                            @foreach (var item in Enum.GetValues(typeof(Statut)))
                            {
                                <MudSelectItem Value="@(EnumDescription.GetDescription((Statut)item))">@EnumDescription.GetDescription((Statut)item)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12">
                        <MudInputLabel Class="pb-2">Pièces manquantes</MudInputLabel>
                        <MudTextField T="string" For="@(() => Command.PiecesManquantes)" @bind-Value="Command.PiecesManquantes" Variant="Variant.Filled" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudInputLabel Class="pb-2">Motif</MudInputLabel>
                        <MudTextField T="string" For="@(() => Command.MotifRejet)" @bind-Value="Command.MotifRejet" Variant="Variant.Filled" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudButton FullWidth Variant="Variant.Filled" Disabled="@(string.IsNullOrEmpty(Command.Statut))" Color="Color.Primary" OnClick="SubmitAsync">
                            Appliquer la modification
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </EditForm>
        </MudPaper>
    </DialogContent>
</MudDialog>